const {
  SlashCommandBuilder,
  EmbedBuilder,
  ActionRowBuilder,
  ButtonBuilder,
  ButtonStyle,
  PermissionFlagsBits,
} = require("discord.js");
const Match = require("../models/Match");

module.exports = {
  data: new SlashCommandBuilder()
    .setName("ipl-match")
    .setDescription("Admin: Setup a new IPL Betting Panel")
    .addStringOption((o) =>
      o.setName("team1").setDescription("Team A (e.g., RCB)").setRequired(true),
    )
    .addStringOption((o) =>
      o.setName("team2").setDescription("Team B (e.g., MI)").setRequired(true),
    ),

  async execute(interaction) {
    // 1. Role Check - Make sure the role name is EXACT
    if (
      !interaction.member.roles.cache.some((r) => r.name === "Casino Manager")
    ) {
      return interaction.reply({
        content: "❌ You need the **Casino Manager** role to use this.",
        ephemeral: true,
      });
    }

    // Defer immediately to prevent "Interaction Failed"
    await interaction.deferReply();

    try {
      const t1 = interaction.options.getString("team1").toUpperCase();
      const t2 = interaction.options.getString("team2").toUpperCase();

      // 2. Clear old match and create new one in DB
      await Match.deleteMany({});

      const newMatch = await Match.create({
        teamA: t1,
        teamB: t2,
        channelId: interaction.channelId,
        status: "OPEN",
        potA: 0,
        potB: 0,
      });

      const embed = new EmbedBuilder()
        .setTitle(`🏏 IPL MATCH: ${t1} vs ${t2}`)
        .setDescription(
          `**Status:** 🟢 BETTING OPEN\n\n**${t1} Pot:** 0 gold\n**${t2} Pot:** 0 gold`,
        )
        .setColor(0x00ff00)
        .setTimestamp();

      const buttons = new ActionRowBuilder().addComponents(
        new ButtonBuilder()
          .setCustomId("bet_team_a")
          .setLabel(`Bet ${t1}`)
          .setStyle(ButtonStyle.Primary),
        new ButtonBuilder()
          .setCustomId("bet_team_b")
          .setLabel(`Bet ${t2}`)
          .setStyle(ButtonStyle.Danger),
        new ButtonBuilder()
          .setCustomId("lock_match")
          .setLabel("🔒 Lock Bets")
          .setStyle(ButtonStyle.Secondary),
      );

      const msg = await interaction.editReply({
        embeds: [embed],
        components: [buttons],
      });

      // Save the message ID to the database
      newMatch.messageId = msg.id;
      await newMatch.save();
    } catch (error) {
      console.error("IPL Match Command Error:", error);
      return interaction.editReply({
        content: "❌ Database Error! Check your console.",
      });
    }
  },
};
