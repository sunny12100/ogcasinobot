const {
  SlashCommandBuilder,
  EmbedBuilder,
  ActionRowBuilder,
  ButtonBuilder,
  ButtonStyle,
} = require("discord.js");
const Match = require("../models/Match");

module.exports = {
  data: new SlashCommandBuilder()
    .setName("ipl-match")
    .setDescription("Admin: Setup a new IPL Betting Panel")
    .addStringOption((o) =>
      o.setName("team1").setDescription("Team A (e.g., RCB)").setRequired(true),
    )
    .addStringOption((o) =>
      o.setName("team2").setDescription("Team B (e.g., MI)").setRequired(true),
    ),

  async execute(interaction) {
    await interaction.deferReply(); // 🔥 prevents interaction failed

    try {
      // 🔐 Role Check
      if (
        !interaction.member.roles.cache.some((r) => r.name === "Casino Manager")
      ) {
        return interaction.editReply({
          content: "❌ Restricted to Casino Managers.",
        });
      }

      const t1 = interaction.options.getString("team1").toUpperCase();
      const t2 = interaction.options.getString("team2").toUpperCase();

      // 🧹 Remove old active matches only
      await Match.deleteMany({ status: "OPEN" });

      // 🆕 Create new match
      const newMatch = await Match.create({
        teamA: t1,
        teamB: t2,
        channelId: interaction.channelId,
        status: "OPEN",
      });

      // 📊 Embed
      const embed = new EmbedBuilder()
        .setTitle(`🏏 IPL MATCH: ${t1} vs ${t2}`)
        .setDescription(
          `**Status:** 🟢 BETTING OPEN\n\n**${t1} Pot:** 0 gold\n**${t2} Pot:** 0 gold`,
        )
        .setColor(0x00ff00)
        .setFooter({
          text: "Zero House Edge | Payouts split by winners",
        })
        .setTimestamp();

      // 🔘 Buttons
      const buttons = new ActionRowBuilder().addComponents(
        new ButtonBuilder()
          .setCustomId(`bet_team_a_${newMatch._id}`) // future-proof
          .setLabel(`Bet ${t1}`)
          .setStyle(ButtonStyle.Primary),

        new ButtonBuilder()
          .setCustomId(`bet_team_b_${newMatch._id}`)
          .setLabel(`Bet ${t2}`)
          .setStyle(ButtonStyle.Danger),

        new ButtonBuilder()
          .setCustomId(`lock_match_${newMatch._id}`)
          .setLabel("🔒 Lock Bets")
          .setStyle(ButtonStyle.Secondary),
      );

      // 📩 Send message
      const msg = await interaction.editReply({
        embeds: [embed],
        components: [buttons],
        fetchReply: true,
      });

      // 💾 Save message ID
      newMatch.messageId = msg.id;
      await newMatch.save();
    } catch (err) {
      console.error(err);

      return interaction.editReply({
        content: "❌ Something went wrong while creating the match.",
      });
    }
  },
};
