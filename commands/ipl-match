const {
  SlashCommandBuilder,
  EmbedBuilder,
  ActionRowBuilder,
  ButtonBuilder,
  ButtonStyle,
} = require("discord.js");
const Match = require("../models/Match");

module.exports = {
  data: new SlashCommandBuilder()
    .setName("ipl-match")
    .setDescription("Admin: Setup a new IPL Betting Panel")
    .addStringOption((o) =>
      o.setName("team1").setDescription("Team A").setRequired(true),
    )
    .addStringOption((o) =>
      o.setName("team2").setDescription("Team B").setRequired(true),
    ),

  async execute(interaction) {
    console.log("--- IPL Match Command Started ---");

    if (
      !interaction.member.roles.cache.some((r) => r.name === "Casino Manager")
    ) {
      console.log("Debug: User lacks Casino Manager role.");
      return interaction.reply({
        content: "❌ Restricted to Casino Managers.",
        ephemeral: true,
      });
    }

    await interaction.deferReply();
    console.log("Debug: Interaction Deferred.");

    try {
      const t1 = interaction.options.getString("team1").toUpperCase();
      const t2 = interaction.options.getString("team2").toUpperCase();

      console.log(
        `Debug: Attempting to clear old matches for ${t1} vs ${t2}...`,
      );
      await Match.deleteMany({});
      console.log("Debug: Database cleared.");

      const newMatch = await Match.create({
        teamA: t1,
        teamB: t2,
        channelId: interaction.channelId,
        status: "OPEN",
        potA: 0,
        potB: 0,
      });
      console.log("Debug: Match created in MongoDB.");

      const embed = new EmbedBuilder()
        .setTitle(`🏏 IPL MATCH: ${t1} vs ${t2}`)
        .setDescription(
          `**Status:** 🟢 BETTING OPEN\n\n**${t1} Pot:** 0 gold\n**${t2} Pot:** 0 gold`,
        )
        .setColor(0x00ff00);

      const buttons = new ActionRowBuilder().addComponents(
        new ButtonBuilder()
          .setCustomId("bet_team_a")
          .setLabel(`Bet ${t1}`)
          .setStyle(ButtonStyle.Primary),
        new ButtonBuilder()
          .setCustomId("bet_team_b")
          .setLabel(`Bet ${t2}`)
          .setStyle(ButtonStyle.Danger),
        new ButtonBuilder()
          .setCustomId("lock_match")
          .setLabel("🔒 Lock Bets")
          .setStyle(ButtonStyle.Secondary),
      );

      const msg = await interaction.editReply({
        embeds: [embed],
        components: [buttons],
      });
      console.log("Debug: Reply sent to Discord.");

      newMatch.messageId = msg.id;
      await newMatch.save();
      console.log("Debug: Match saved with Message ID. SUCCESS.");
    } catch (error) {
      console.error("CRITICAL ERROR IN IPL-MATCH:", error);
      return interaction.editReply({ content: `❌ Error: ${error.message}` });
    }
  },
};
